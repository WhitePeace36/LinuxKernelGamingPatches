From 3d023dc1cc1e0a2f629865926a2497b96d128ed5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 16:42:18 +0100
Subject: [PATCH] Remove RDP mentions, drop the committed memstress binary,
 README fixes

- interruption docs no longer mention RDP sessions
- tools/memstress was a compiled binary; build it from memstress.c instead
  (now in .gitignore, build command in the README)
- README: real clone URL, fragwatch.sh and memstress -q documented,
  license note matches LICENSE (GPL-2.0)
- memdiff.sh also records pgmigrate_success, pswpin and pswpout

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Jpc2uj1P9if4WYVKq5YGZK
---
 .gitignore        |   1 +
 README.md         |  17 ++++++++++++-----
 customization.cfg |   6 +++---
 tools/memdiff.sh  |   2 +-
 tools/memstress   | Bin 26968 -> 0 bytes
 5 files changed, 17 insertions(+), 9 deletions(-)
 delete mode 100755 tools/memstress

diff --git a/.gitignore b/.gitignore
index 765bd91..c1ec918 100644
--- a/.gitignore
+++ b/.gitignore
@@ -6,3 +6,4 @@ linux-*.tar.*
 .lunar-base.config
 .lunar-releases.json*
 lunar-config/last-config-*
+tools/memstress
diff --git a/README.md b/README.md
index 52b68d3..dd4823f 100644
--- a/README.md
+++ b/README.md
@@ -8,7 +8,7 @@ third-party changes.
 ## Quick start
 
 ```bash
-git clone <this repo> && cd linux-lunar
+git clone https://github.com/WhitePeace36/linux-lunar.git && cd linux-lunar
 $EDITOR customization.cfg        # or ~/.config/linux-lunar.cfg for your overrides
 ./lunar.sh                       # asks for the kernel version, builds, installs
 ```
@@ -90,7 +90,7 @@ THP, MGLRU, headers package. See the comments in `customization.cfg`.
 
 ## Interrupting and cleaning up
 
-Ctrl+C, closing the terminal or RDP session, or `kill` stops every build
+Ctrl+C, closing the terminal, or `kill` stops every build
 process (makepkg, make, compilers) and removes `src/`, `pkg/` and partial
 downloads (`_cleanup_on_abort`; set it to `"false"` to keep `src/` for
 debugging). A failed build is cleaned up the same way. After a successful build
@@ -107,7 +107,8 @@ build.
 
 ## Measuring
 
-`tools/` holds what was used to test the patches:
+`tools/` holds what was used to test the patches. Build `memstress` first:
+`gcc -O2 -pthread -o tools/memstress tools/memstress.c`
 
 | Tool | Use |
 | --- | --- |
@@ -115,6 +116,11 @@ build.
 | `memdiff.sh` | counter deltas (allocstall, compact_stall, THP, PSI, ...) across a gaming session |
 | `memstress.c` | provoke stalls: fragmented page cache, pinned unmovable pages, THP heap, streaming reads, optional 2:1-compressible anonymous load (`-a GiB`) for zram |
 | `memstall.bt` | bpftrace: every direct reclaim / compaction stall > 1 ms with process and order |
+| `fragwatch.sh` | live fragmentation score, free 2 MiB blocks, kswapd state, compaction migrations and THP success per second |
+
+`memstress -q <sec> -B <MiB> -t 0` tests proactive compaction on its own: after
+the fragmenting setup it stays idle for `<sec>` seconds, then touches one THP
+burst and reports how many 2 MiB chunks got a huge page.
 
 ## Test status
 
@@ -146,5 +152,6 @@ drafts. Patch 0005 matches an approach already under discussion upstream
 linux-mm, July 2026), where it is disputed. Upstream submissions must follow
 `Documentation/process/coding-assistants.rst` and carry a human Signed-off-by.
 
-The kernel patches are GPL-2.0-only, like the kernel. Packaging follows the
-structure of Arch Linux's `linux` PKGBUILD.
+Everything in this repository is licensed under GPL-2.0 (see `LICENSE`), like
+the kernel the patches are for. Packaging follows the structure of Arch Linux's
+`linux` PKGBUILD.
diff --git a/customization.cfg b/customization.cfg
index 5f0830d..731c6a1 100644
--- a/customization.cfg
+++ b/customization.cfg
@@ -147,9 +147,9 @@ _noninteractive="false"
 
 #### CLEANUP ##################################################################
 
-# When the build is interrupted (Ctrl+C, terminal or RDP session closed,
-# kill) or fails: stop all build processes and delete src/, pkg/ and partial
-# downloads. Set to "false" to keep src/ for debugging a failed build.
+# When the build is interrupted (Ctrl+C, terminal closed, kill) or fails:
+# stop all build processes and delete src/, pkg/ and partial downloads.
+# Set to "false" to keep src/ for debugging a failed build.
 _cleanup_on_abort="true"
 
 # After a successful build: delete src/ and pkg/ (several GB). The packages
diff --git a/tools/memdiff.sh b/tools/memdiff.sh
index f6c7b4f..77280ed 100755
--- a/tools/memdiff.sh
+++ b/tools/memdiff.sh
@@ -4,7 +4,7 @@
 set -euo pipefail
 
 label="${1:-run}"
-keys='allocstall_|pgscan_direct|pgscan_direct_throttle|pgscan_kswapd|pgsteal_kswapd|kswapd_low_wmark_hit_quickly|compact_stall|compact_fail|compact_daemon_wake|thp_fault_alloc|thp_fault_fallback|workingset_refault_file|workingset_activate_file|pgmajfault'
+keys='allocstall_|pgscan_direct|pgscan_direct_throttle|pgscan_kswapd|pgsteal_kswapd|kswapd_low_wmark_hit_quickly|compact_stall|compact_fail|compact_daemon_wake|pgmigrate_success|thp_fault_alloc|thp_fault_fallback|workingset_refault_file|workingset_activate_file|pgmajfault|pswpin|pswpout'
 
 snap() {
 	grep -E "^($keys)" /proc/vmstat
